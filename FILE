} MenuItem;

static const MenuItem menu[] = {
    {"PIZZAS", "Pepperoni Pizza",            450.00f},
    {"PIZZAS", "Hawaiian Pizza",             450.00f},
    {"PIZZAS", "Cheese Pizza",               420.00f},
    {"PIZZAS", "Garden Fresh Pizza",         430.00f},
